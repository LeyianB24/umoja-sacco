# USMS Git Inhibition List

# Dependencies
vendor/
**/vendor/
/composer.lock
node_modules/
**/node_modules/

# Next.js & Build Output
.next/
**/.next/
out/
build/
dist/
*.tsbuildinfo

# Environment & Configuration (NEVER commit credentials!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.*.local
.env.railway

config/database.php
config/environment.php
backend/config/database.php
backend/config/environment.php

# Sensitive Assets & Uploads
uploads/*
**/uploads/*
!**/uploads/**/.gitkeep
!**/uploads/**/.htaccess
/cert/
**/cert/
/member/uploads/
**/member/uploads/
/public/uploads/
**/public/uploads/*
!**/public/uploads/**/.gitkeep
storage/cache/*
**/storage/cache/*
!**/storage/cache/.gitkeep
storage/logs/*
**/storage/logs/*
!**/storage/logs/.gitkeep

# Development Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.txt
*.pdf
!composer.json
.phpunit.result.cache

# IDEs & OS
.vscode/
.vs/
.idea/
.DS_Store
Thumbs.db
