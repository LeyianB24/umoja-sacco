# ── Playwright E2E Test Environment ─────────────────────────────────────────
# Copy this file to .env.test.local (gitignored) and fill in real values.
# Never commit real credentials.

# Base URL for the app under test (local or staging)
BASE_URL=http://localhost:3000

# Test member credentials — must exist in the test database
E2E_MEMBER_EMAIL=testmember@example.com
E2E_MEMBER_PASSWORD=TestPassword123!
